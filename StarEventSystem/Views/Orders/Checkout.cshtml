@model dynamic
@using StarEventSystem.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Checkout";
    var eventDetails = ViewBag.Event as StarEventSystem.Models.Event;
    var selectedTickets = ViewBag.SelectedTickets as IEnumerable<dynamic>;
    decimal total = ViewBag.Total;
}

<h2>Checkout - @eventDetails.EventName</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ticket Type</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in selectedTickets)
        {
            <tr>
                <td>@ticket.TicketType.TypeName</td>
                <td>@ticket.Quantity</td>
                <td>@ticket.TicketType.Price.ToString("C")</td>
                <td>@ticket.Subtotal</td>
            </tr>
        }
    </tbody>
</table>

<h3>Total: @total.ToString("C")</h3>
<h4>Redeem Points</h4>
@if (SignInManager.IsSignedIn(User))
{
    <p>You have @UserManager.GetUserAsync(User).Result.Points points available.</p>
    <input type="number" id="RedeemPoints" min="0" max="@UserManager.GetUserAsync(User).Result.Points" value="0" class="form-control mb-2" />
    <small>1 point = 1 USD</small>
}

<!-- PayPal button -->
<div id="paypal-button-container" class="mt-3"></div>

<script src="https://www.paypal.com/sdk/js?client-id=AZZ7mF8tKQuGUD9ysgkUQQ2QSm_Knz8O7Jo8hsVzoxPEcWzi0yYrbBI0a-2nZAS2wN_VK50G6qc0WPLX&currency=USD"></script>
<script>
    paypal.Buttons({
        createOrder: function(data, actions) {
            var redeemPoints = document.getElementById("RedeemPoints") ? document.getElementById("RedeemPoints").value : 0;
			var totalAmount = @total - redeemPoints;
            return actions.order.create({
                purchase_units: [{
                    amount: { value: totalAmount }
                }]
            });
        },
        onApprove: function(data, actions) {
            return actions.order.capture().then(function(details) {

                var redeemPoints = document.getElementById("RedeemPoints") ? document.getElementById("RedeemPoints").value : 0;
                var totalAmount = @total - redeemPoints;

                // Send order data to server
                var form = new FormData();
                form.append("EventId", "@eventDetails.EventId");
                form.append("TotalAmount", totalAmount);
                form.append("RedeemedPoints", redeemPoints);

                @foreach (var ticket in selectedTickets)
                {
                        <text>form.append("Quantities[@ticket.TicketType.TicketTypeId]", "@ticket.Quantity");</text>
                }

                fetch('@Url.Action("PlaceOrder", "Orders")', {
                    method: 'POST',
                    body: form
                })
                .then(response => response.json())
                .then(result => {
                    if(result.success){
                        window.location.href = '/Orders/OrderConfirmation?orderId=' + result.orderId;
                    } else {
                        alert('Error placing order!');
                    }
                });
            });
        }
    }).render('#paypal-button-container');
</script>

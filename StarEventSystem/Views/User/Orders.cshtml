@model IEnumerable<StarEventSystem.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<h2>My Orders</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no orders yet.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>OrderId</th>
                <th>Event</th>
                <th>Tickets</th>
                <th>Total Amount</th>
                <th>Date</th>
                <th>QR Code</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.Event.EventName</td>
                    <td>
                        @foreach (var item in order.OrderItems)
                        {
                            <div>@item.TicketType.TypeName x @item.Quantity</div>
                        }
                    </td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>@order.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(order.QrCodeBase64))
                        {
                            <img src="data:image/png;base64,@order.QrCodeBase64" width="100" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a href="@Url.Action("ExportOrdersCsv", "User")" class="btn btn-success">Download CSV</a>
}
